{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$p": {
        ".write": "auth != null && (!data.exists() || data.child('u').val() === auth.uid) && (!newData.exists() || newData.child('u').val() === auth.uid)",
        ".validate": "newData.hasChildren(['u','t','p'])"
      }
    },
    "accounts": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['k','n','salt','hash']) && newData.child('n').isString() && newData.child('n').val().length <= 14 && newData.child('hash').isString() && newData.child('hash').val().length <= 100"
      }
    },
    "scores": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$f": {
          ".validate": "($f == 'k' || $f == 'n' || $f == 'cr') ? (newData.isString() && newData.val().length <= 60) : (newData.isNumber() && ($f == 'ts' || $f == 'cp' || $f.beginsWith('cw_') || newData.val() <= 600000))"
        }
      }
    },
    "ratings": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('elo').isNumber() && newData.child('elo').val() >= 100 && newData.child('elo').val() <= 4000"
      }
    },
    "requests": {
      ".read": "auth != null",
      "$r": {
        ".write": "auth != null && (data.exists() ? true : newData.child('o').val() === auth.uid)",
        ".validate": "newData.hasChildren(['a','b','st','o']) && (newData.child('st').val() === 'pending' || newData.child('st').val() === 'friends') && (!data.exists() || newData.child('o').val() === data.child('o').val())"
      }
    },
    "invites": {
      ".read": "auth != null",
      "$i": {
        ".write": "auth != null && (data.exists() ? true : newData.child('o').val() === auth.uid)",
        ".validate": "newData.hasChildren(['to','from','code','st','o']) && (!data.exists() || newData.child('o').val() === data.child('o').val())"
      }
    },
    "crews": {
      ".read": "auth != null",
      "$c": {
        ".write": "auth != null && (!data.exists() ? newData.child('ou').val() === auth.uid : (!newData.exists() ? data.child('ou').val() === auth.uid || !data.child('m').exists() : true))",
        ".validate": "newData.hasChildren(['n','tag','col','m','ou']) && (!data.exists() || newData.child('ou').val() === data.child('ou').val() || newData.child('o').exists())"
      }
    },
    "shared": {
      ".read": "auth != null",
      "$s": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['d','park','score']) && newData.child('d').isString() && newData.child('d').val().length < 240000"
      }
    },
    "highlights": {
      ".read": "auth != null",
      "$h": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['code','score','wk'])"
      }
    },
    "data": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}